#!/usr/bin/env bash
# evaldctl — evald 的 tmux 启停（板上运行，无需 root）
# 用法: evaldctl start|stop|restart|status|logs
set -u
DIR="$(cd "$(dirname "$0")" && pwd)"
SESS=evald

start() {
  if tmux has-session -t "$SESS" 2>/dev/null; then
    echo "evald 已在运行 (tmux: $SESS)"
    return 0
  fi
  tmux new-session -d -s "$SESS" "cd '$DIR' && exec python3 evald.py --config '$DIR/config.json' >> '$DIR/evald.log' 2>&1"
  sleep 1
  status
}

stop() {
  tmux kill-session -t "$SESS" 2>/dev/null && echo "evald 已停止" || echo "evald 未在运行"
}

status() {
  if tmux has-session -t "$SESS" 2>/dev/null; then
    echo "tmux: running"
    curl -s --max-time 3 "http://127.0.0.1:$(python3 -c "import json;print(json.load(open('$DIR/config.json'))['port'])")/healthz" || echo "(healthz 无响应)"
    echo
  else
    echo "tmux: stopped"
  fi
}

logs() { tail -n 200 -f "$DIR/evald.log"; }

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  logs) logs ;;
  *) echo "用法: $0 start|stop|restart|status|logs"; exit 1 ;;
esac
