#!/usr/bin/env bash
# evaldctl — evald 的守护启停（板上运行；setsid+nohup+pidfile，无交互终端依赖，适合 @reboot）
# 用法: evaldctl start|stop|restart|status|logs
set -u
DIR="$(cd "$(dirname "$0")" && pwd)"
PID_FILE="$DIR/evald.pid"
LOG="$DIR/evald.log"
PORT="$(python3 -c "import json;print(json.load(open('$DIR/config.json'))['port'])")"

pid_alive() {
  [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

start() {
  if pid_alive; then
    echo "evald 已在运行 (pid $(cat "$PID_FILE"))"
    return 0
  fi
  rm -f "$PID_FILE"
  setsid nohup python3 "$DIR/evald.py" --config "$DIR/config.json" >> "$LOG" 2>&1 &
  echo $! > "$PID_FILE"
  sleep 1
  status
}

stop() {
  if pid_alive; then
    kill "$(cat "$PID_FILE")" && echo "evald 已停止"
    rm -f "$PID_FILE"
  else
    echo "evald 未在运行"
    rm -f "$PID_FILE"
  fi
}

status() {
  if pid_alive; then
    echo "process: running (pid $(cat "$PID_FILE"))"
    curl -s --max-time 3 "http://127.0.0.1:$PORT/healthz" || echo "(healthz 无响应)"
    echo
  else
    echo "process: stopped"
  fi
}

logs() { tail -n 200 -f "$LOG"; }

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  logs) logs ;;
  *) echo "用法: $0 start|stop|restart|status|logs"; exit 1 ;;
esac
